{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/schema/main/schema.json",
  "mcpServers": {
    "archmcp": {
      "url": "http://127.0.0.1:8000/sse",
      "headers": {
        "Authorization": "Bearer arch_live_<YOUR_KID>_<YOUR_SECRET_TOKEN>"
      }
    },
    "archmcp-query-param": {
      "url": "http://127.0.0.1:8000/sse?token=arch_live_<YOUR_KID>_<YOUR_SECRET_TOKEN>"
    }
  }
}
