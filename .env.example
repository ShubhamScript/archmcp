# ArchMCP Enterprise Environment Configuration

# Server Settings
APP_NAME=ArchMCP Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# Enterprise Security & KeyStore
AUTH_ENABLED=true
KEY_STORE_FILE=data/keystore.json
BOOTSTRAP_ADMIN_KEY=true

# Sliding Window Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Structured Security Audit Logging
AUDIT_LOG_FILE=data/audit.log

# Enterprise OIDC / OAuth2 Integration (Optional)
OIDC_ENABLED=false
OIDC_ISSUER=https://auth.company.com
OIDC_AUDIENCE=archmcp-api

# Data Paths
REPOSITORIES_FILE=data/repositories.yaml
