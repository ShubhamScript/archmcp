# ArchMCP Environment Configuration

# Server Settings
APP_NAME=ArchMCP Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Auth Settings
# Comma-separated list of valid client bearer tokens (e.g. employee tokens or API keys)
AUTH_TOKENS=dev-token-secret-123,employee-key-abc,cursor-user-456
AUTH_ENABLED=true

# Data Paths
REPOSITORIES_FILE=data/repositories.yaml
DATABASE_PATH=:memory:
